{
  "name": "@job-agent/db",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "migrations"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "node --env-file-if-exists=../../.env --enable-source-maps dist/migrate.js",
    "migrate:test": "node --env-file-if-exists=../../.env --enable-source-maps dist/migrate.js --test",
    "seed": "node --env-file-if-exists=../../.env --enable-source-maps dist/seeds/seed.js",
    "seed:dev": "node --env-file-if-exists=../../.env --enable-source-maps dist/seeds/seed-dev.js",
    "studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@job-agent/shared": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "vitest": "^5.1.0"
  }
}
