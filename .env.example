# Application
NODE_ENV=development
APP_PORT=3000
APP_VERSION=
# Time zone of the app process (node --env-file) and of every container: dates in logs and in the database
# are shown in local time. Asia/Jerusalem or Europe/Kyiv
TZ=Asia/Jerusalem

# Logs: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# Loki of docker compose (view in Grafana); empty = stdout only
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:3100/otlp
LOKI_PORT=3100
GRAFANA_PORT=3003

# PostgreSQL (docker compose). Host ports are shifted to avoid a local Postgres / Redis
POSTGRES_USER=job_agent
POSTGRES_PASSWORD=job_agent
POSTGRES_DB=job_agent
POSTGRES_PORT=5433
DATABASE_URL=postgres://job_agent:job_agent@localhost:5433/job_agent
DATABASE_URL_TEST=postgres://job_agent:job_agent@localhost:5433/job_agent_test
DATABASE_CONNECTION_TIMEOUT_MS=5000

# Redis (docker compose) and Bull Board
REDIS_HOST=localhost
REDIS_PORT=6380
BULL_BOARD_PATH=/queues

# LLM: anthropic (cloud) or ollama (local, Mac). Model and parameters of each step live in the llm_settings table
LLM_PROVIDER=anthropic
LLM_TIMEOUT_MS=60000
# Required when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Required when LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
# 1 for Ollama (one request at a time), more for the cloud
EXTRACT_CONCURRENCY=4

# Limit of each /health check (Postgres, Redis, LLM)
HEALTH_CHECK_TIMEOUT_MS=3000

# Resume files and other documents, relative to the working directory of the command
STORAGE_DIR=storage
